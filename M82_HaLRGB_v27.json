{
  "version": 2,
  "name": "M82 HaLRGB v27 (NXT crossover above PSF: frequency_scale 8px)",
  "files": {
    "sourceFolder": "Z:/M82/claude-masters-cc/working-rc",
    "L": "Z:/M82/claude-masters-cc/working-rc/M82_L.xisf",
    "R": "Z:/M82/claude-masters-cc/working-rc/M82_R.xisf",
    "G": "Z:/M82/claude-masters-cc/working-rc/M82_G.xisf",
    "B": "Z:/M82/claude-masters-cc/working-rc/M82_B.xisf",
    "Ha": "Z:/M82/claude-masters-cc/working-rc/M82_Ha.xisf",
    "outputDir": "Z:/M82/claude-processed",
    "targetName": "M82"
  },
  "branches": {
    "main": {
      "label": "RGB",
      "color": "#4a9eff"
    },
    "stars": {
      "label": "Stars",
      "color": "#f5c542",
      "forkAfter": "sxt"
    },
    "ha": {
      "label": "H-alpha",
      "color": "#e94560",
      "forkAfter": "combine_rgb"
    },
    "lum": {
      "label": "Luminance",
      "color": "#c084fc",
      "forkAfter": "sxt"
    }
  },
  "steps": [
    {
      "id": "combine_rgb",
      "name": "Combine RGB",
      "branch": "main",
      "enabled": true,
      "params": {}
    },
    {
      "id": "gc",
      "name": "GradientCorrection (per-channel)",
      "branch": "main",
      "enabled": true,
      "params": {
        "perChannel": true,
        "method": "auto"
      }
    },
    {
      "id": "bxt_correct",
      "name": "BXT (correctOnly)",
      "branch": "main",
      "enabled": true,
      "params": {
        "sharpenStars": 0.5,
        "sharpenNonstellar": 0.75,
        "adjustStarHalos": 0
      }
    },
    {
      "id": "plate_solve",
      "name": "Plate Solve (copy WCS from R)",
      "branch": "main",
      "enabled": true,
      "params": {}
    },
    {
      "id": "spcc",
      "name": "SPCC (after SPFC)",
      "branch": "main",
      "enabled": true,
      "params": {
        "_note": "v6: replaced by SPFC (Dan) — flux calibration measures color, no white reference",
        "whiteReferenceName": "Average Spiral Galaxy",
        "sensorQE": "Sony IMX411/455/461/533/571",
        "filterSet": "Optolong LRGB",
        "narrowbandMode": false,
        "generateGraphs": false
      }
    },
    {
      "id": "spfc",
      "name": "SPFC (spectrophotometric flux calibration)",
      "branch": "main",
      "enabled": true,
      "params": {
        "sensorQE": "Sony IMX411/455/461/533/571",
        "filterSet": "Optolong LRGB",
        "narrowbandMode": false
      }
    },
    {
      "id": "scnr",
      "name": "SCNR",
      "branch": "main",
      "enabled": false,
      "params": {
        "_note": "v7: OFF (Dan: lets try to live without it) — under flux calibration it removes real green and pushes magenta",
        "amount": 0.3
      }
    },
    {
      "id": "bxt_sharpen",
      "name": "BXT (sharpening)",
      "branch": "main",
      "enabled": true,
      "params": {
        "_note": "moderate — L branch carries the structure sharpening; RGB just needs cleanup",
        "sharpenStars": 0.25,
        "sharpenNonstellar": 0.7,
        "adjustStarHalos": 0
      }
    },
    {
      "id": "nxt_pass1",
      "name": "NXT Pass 1 (linear RGB)",
      "branch": "main",
      "enabled": true,
      "params": {
        "denoise": 0.3,
        "detail": 0.2,
        "denoiseLf": 0.55,
        "frequencySeparation": true,
        "frequencyScale": 8
      }
    },
    {
      "id": "sxt",
      "name": "SXT",
      "branch": "main",
      "enabled": true,
      "params": {
        "_note": "galaxy field: watch for starburst-knot residuals in the star frame; knowledge doc says consider disabling entirely if leaks show",
        "overlap": 0.2,
        "recoverNebulosity": true
      }
    },
    {
      "id": "star_stretch",
      "name": "Star Extraction (non-linear unscreen)",
      "branch": "stars",
      "enabled": true,
      "params": {
        "starMethod": "nonlinear",
        "_note": "v6: unscreen extraction (Dan) — stars ride the main stretch, SXT unscreen pulls them from the stretched image; ghs params below are used only for the stars_L blend stretch; blackpoint = darkest frame tile, not median+sigma",
        "ghs": {
          "D": 3.5,
          "b": 4,
          "SP": 0.01,
          "LP": 0,
          "HP": 0.55,
          "bpMethod": "darkTile",
          "bpTileSize": 256
        },
        "scnrGreen": false
      }
    },
    {
      "id": "star_saturate",
      "name": "Star Saturation",
      "branch": "stars",
      "enabled": true,
      "params": {
        "_note": "v9: faint-end saturation halved — the 0.10->0.55 curve was turning star-layer noise and slight channel imbalances into color confetti and lime stars",
        "starSaturationCurve": [
          [
            0,
            0
          ],
          [
            0.1,
            0.3
          ],
          [
            0.3,
            0.6
          ],
          [
            0.55,
            0.85
          ],
          [
            1,
            1
          ]
        ]
      }
    },
    {
      "id": "star_reduce",
      "name": "Star Reduction",
      "branch": "stars",
      "enabled": false,
      "params": {
        "_note": "DISABLED — ring artifacts on galaxy fields (M81/M82 lesson, no exceptions)"
      }
    },
    {
      "id": "ha_gc",
      "name": "Ha GradientCorrection",
      "branch": "ha",
      "enabled": true,
      "params": {
        "_note": "v3: Ha master carries the field's strong sky gradient; without this the injected red follows it — Dan flagged red background in v1",
        "method": "auto"
      }
    },
    {
      "id": "ha_continuum",
      "name": "Ha Continuum Subtraction",
      "branch": "ha",
      "enabled": true,
      "params": {
        "_note": "Dan's call: subtract scaled R from Ha, inject only the emission remainder — removes the broadband red wash at the source",
        "factor": 1
      }
    },
    {
      "id": "ha_bxt_correct",
      "name": "Ha BXT (correctOnly, pre-SXT)",
      "branch": "ha",
      "enabled": true,
      "params": {
        "_note": "v5: BXT before StarX on every branch (Dan) — aberrated PSFs make SXT leave munged residuals",
        "sharpenStars": 0.5,
        "sharpenNonstellar": 0.75,
        "adjustStarHalos": 0
      }
    },
    {
      "id": "ha_sxt",
      "name": "Ha SXT",
      "branch": "ha",
      "enabled": true,
      "params": {
        "overlap": 0.2,
        "recoverNebulosity": true
      }
    },
    {
      "id": "ha_stretch",
      "name": "Ha Stretch",
      "branch": "ha",
      "enabled": true,
      "params": {
        "targetBg": 0.1
      }
    },
    {
      "id": "ha_curves",
      "name": "Ha Curves",
      "branch": "ha",
      "enabled": false,
      "params": {}
    },
    {
      "id": "ha_ghs",
      "name": "Ha GHS",
      "branch": "ha",
      "enabled": false,
      "params": {}
    },
    {
      "id": "l_bxt_correct",
      "name": "L BXT (correctOnly, pre-SXT)",
      "branch": "lum",
      "enabled": true,
      "params": {
        "_note": "v5: THE fix for munged stars — v3 ran L SXT on uncorrected PSFs (elongated stars in this data), leaving double-halo residuals in starless L",
        "sharpenStars": 0.5,
        "sharpenNonstellar": 0.75,
        "adjustStarHalos": 0
      }
    },
    {
      "id": "l_bxt_sharpen",
      "name": "L BXT sharpen (linear, pre-SXT)",
      "branch": "lum",
      "enabled": true,
      "params": {
        "_note": "v5: BXT belongs on linear data — replaces the old post-stretch l_bxt (now disabled)",
        "sharpenStars": 0.25,
        "sharpenNonstellar": 0.8,
        "adjustStarHalos": 0
      }
    },
    {
      "id": "l_sxt",
      "name": "L SXT",
      "branch": "lum",
      "enabled": true,
      "params": {
        "overlap": 0.2,
        "recoverNebulosity": true
      }
    },
    {
      "id": "star_lum_blend",
      "name": "L Star Lightness Blend",
      "branch": "stars",
      "enabled": false,
      "params": {
        "_note": "v6: OFF permanently for this target — Dan: do not use the L stars for anything after BXT. Final stars = RGB unscreen extraction only; L stars are discarded at l_sxt.",
        "lightness": 0.5,
        "saturation": 0.5
      }
    },
    {
      "id": "l_stretch",
      "name": "L Stretch",
      "branch": "lum",
      "enabled": true,
      "params": {
        "targetBg": 0.1,
        "hdrHeadroom": 0.1
      }
    },
    {
      "id": "l_nxt",
      "name": "L NXT (post-stretch)",
      "branch": "lum",
      "enabled": true,
      "params": {
        "denoise": 0.35,
        "detail": 0.2,
        "denoiseLf": 0.65,
        "frequencySeparation": true,
        "frequencyScale": 8
      }
    },
    {
      "id": "l_bxt",
      "name": "L BXT (structure, post-stretch)",
      "branch": "lum",
      "enabled": false,
      "params": {
        "_note": "v5: disabled — superseded by linear l_bxt_sharpen; BXT on stretched data is off-label",
        "sharpenStars": 0.15,
        "sharpenNonstellar": 0.5,
        "adjustStarHalos": 0
      }
    },
    {
      "id": "stretch",
      "name": "Stretch (HT+GHS)",
      "branch": "main",
      "enabled": true,
      "params": {
        "targetBg": 0.1,
        "hdrHeadroom": 0.05,
        "ghsPasses": [
          {
            "label": "Midtone boost",
            "D": 0.6,
            "B": -1,
            "LP": 0.02,
            "HP": 0.95
          },
          {
            "label": "Fine contrast",
            "D": 0.3,
            "B": -1.5,
            "LP": 0.03,
            "HP": 0.9
          }
        ]
      }
    },
    {
      "id": "nxt_pass2",
      "name": "NXT Pass 2 (post-stretch)",
      "branch": "main",
      "enabled": true,
      "params": {
        "denoise": 0.35,
        "detail": 0.2,
        "denoiseLf": 0.65,
        "frequencySeparation": true,
        "frequencyScale": 8
      }
    },
    {
      "id": "curves_main",
      "name": "Curves (house style, muted)",
      "branch": "main",
      "enabled": true,
      "params": {
        "contrastCurve": [
          [
            0,
            0
          ],
          [
            0.06,
            0.03
          ],
          [
            0.5,
            0.57
          ],
          [
            0.92,
            0.97
          ],
          [
            1,
            1
          ]
        ],
        "saturationCurve": [
          [
            0,
            0
          ],
          [
            0.5,
            0.66
          ],
          [
            1,
            0.95
          ]
        ]
      }
    },
    {
      "id": "ha_inject",
      "name": "Ha Injection (superwind)",
      "branch": "main",
      "merges": [
        "ha"
      ],
      "enabled": true,
      "params": {
        "_note": "v3: red wash fixed at the ROOT by ha_continuum (Dan's call), so injection returns to full strength on pure emission. lumBoost stays moderate — emission-only lum lift.",
        "injectionStrength": 0.65,
        "haThreshold": 0.3,
        "detailLayer": 0.55,
        "lumBoost": 0.25,
        "maskClipLow": 0.04,
        "maskBlur": 8
      }
    },
    {
      "id": "lrgb_combine",
      "name": "LRGB Combine",
      "branch": "main",
      "merges": [
        "lum"
      ],
      "enabled": true,
      "params": {
        "_note": "large bright galaxy: lightness 0.50 per galaxy table; LinearFit L->RGB lum guard",
        "lightness": 0.5,
        "saturation": 0.36,
        "linearFitRejectHigh": 0.92
      }
    },
    {
      "id": "lhe",
      "name": "LHE (structural)",
      "branch": "main",
      "enabled": true,
      "params": {
        "radius": 64,
        "amount": 0.35,
        "slopeLimit": 1.5,
        "maskGamma": 2
      }
    },
    {
      "id": "lhe_fine",
      "name": "LHE Fine",
      "branch": "main",
      "enabled": false,
      "params": {}
    },
    {
      "id": "hdrmt",
      "name": "HDR Multiscale (core detail)",
      "branch": "main",
      "enabled": true,
      "params": {
        "numberOfLayers": 7,
        "numberOfIterations": 1,
        "toLightness": true,
        "maskClipLow": 0.1,
        "maskGamma": 1.5
      }
    },
    {
      "id": "nxt_final",
      "name": "NXT Final (light cleanup)",
      "branch": "main",
      "enabled": true,
      "params": {
        "denoise": 0.25,
        "detail": 0.2,
        "denoiseLf": 0.45,
        "frequencySeparation": true,
        "frequencyScale": 8
      }
    },
    {
      "id": "bg_neutralize",
      "name": "Background Neutralize",
      "branch": "main",
      "enabled": true,
      "params": {
        "_note": "v9: sky now sits ~0.03 — the old 0.09 threshold desaturated galaxy low-mids (khaki flatness). Ramp lowered to hug the actual background.",
        "threshold": 0.06,
        "transition": 0.08
      }
    },
    {
      "id": "chroma_denoise",
      "name": "Chroma Denoise (color speckle)",
      "branch": "main",
      "enabled": true,
      "params": {
        "_note": "v9: luminance-protected a*/b* smoothing — kills the color confetti without touching structure; runs before star_add so star colors stay pristine",
        "sigmaA": 2.6,
        "sigmaB": 3.75
      }
    },
    {
      "id": "curves_final",
      "name": "Final Curves (house style)",
      "branch": "main",
      "enabled": true,
      "params": {
        "lightnessCurve": [
          [
            0,
            0
          ],
          [
            0.05,
            0.012
          ],
          [
            0.1,
            0.055
          ],
          [
            0.5,
            0.56
          ],
          [
            0.9,
            0.94
          ],
          [
            1,
            1
          ]
        ],
        "saturationCurve": [
          [
            0,
            0
          ],
          [
            0.5,
            0.74
          ],
          [
            1,
            0.95
          ]
        ],
        "channelBoost": {
          "R": 1,
          "G": 0.85,
          "B": 1.12
        }
      }
    },
    {
      "id": "star_add",
      "name": "Star Addition (screen blend)",
      "branch": "main",
      "merges": [
        "stars"
      ],
      "enabled": true,
      "params": {
        "_note": "screen blend essential for galaxies — straight add shows SXT residual rims",
        "starStrength": 0.85,
        "screenBlend": true
      }
    }
  ],
  "output": {}
}