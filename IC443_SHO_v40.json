{
  "version": 2,
  "name": "IC443 SHO + RGB stars (Iteration 40 - CC+ESD+rangeclip masters, v37 params)",
  "files": {
    "sourceFolder": "Z:/IC 443/claude-masters-cc/working",
    "L": "",
    "R": "Z:/IC 443/claude-masters-cc/working/IC443_SII.xisf",
    "G": "Z:/IC 443/claude-masters-cc/working/IC443_Ha.xisf",
    "B": "Z:/IC 443/claude-masters-cc/working/IC443_OIII.xisf",
    "Ha": "",
    "outputDir": "Z:/IC 443/claude-processed",
    "targetName": "IC443"
  },
  "branches": {
    "main": { "label": "SHO", "color": "#4a9eff" },
    "stars": { "label": "Stars", "color": "#f5c542", "forkAfter": "sxt" },
    "ha": { "label": "H-alpha", "color": "#e94560", "forkAfter": "combine_rgb" },
    "lum": { "label": "SynthLum", "color": "#c084fc", "forkAfter": "sxt" }
  },
  "steps": [
    { "id": "combine_rgb", "name": "Combine SHO", "branch": "main", "enabled": true, "params": {} },
    { "id": "gc", "name": "GradientCorrection", "branch": "main", "enabled": true,
      "params": { "perChannel": true, "method": "auto" } },
    { "id": "bxt_correct", "name": "BXT (correctOnly)", "branch": "main", "enabled": true,
      "params": { "sharpenStars": 0.50, "sharpenNonstellar": 0.90, "adjustStarHalos": 0.00 } },
    { "id": "plate_solve", "name": "Plate Solve", "branch": "main", "enabled": false, "params": {} },
    { "id": "spcc", "name": "SPCC", "branch": "main", "enabled": false,
      "params": { "_note": "disabled — false-color SHO palette, color calibration meaningless" } },
    { "id": "scnr", "name": "SCNR", "branch": "main", "enabled": false,
      "params": { "_note": "disabled — green IS Ha in SHO; SCNR would gut the palette" } },
    { "id": "bxt_sharpen", "name": "BXT (sharpening)", "branch": "main", "enabled": true,
      "params": { "_note": "iter31: nonstellar cranked 0.50->0.90 for SNR filament detail. Nebula stars get chewed but that's fine — SXT removes them and RGB stars (external file) replace them, so sharpenStars is irrelevant to the final image.",
                  "sharpenStars": 0.25, "sharpenNonstellar": 0.90, "adjustStarHalos": 0.00 } },
    { "id": "nxt_pass1", "name": "NXT Pass 1", "branch": "main", "enabled": true,
      "params": { "_note": "iter32: eased 0.30->0.20, detail 0.15->0.20 so BXT 0.90 filament detail survives", "denoise": 0.20, "detail": 0.20 } },
    { "id": "sxt", "name": "SXT", "branch": "main", "enabled": true,
      "params": { "overlap": 0.20, "recoverNebulosity": true } },
    { "id": "star_stretch", "name": "Star Stretch", "branch": "stars", "enabled": false,
      "params": { "_note": "disabled — stars come from IC443_rgb_stars.xisf via star_add.starsFile" } },
    { "id": "star_saturate", "name": "Star Saturation", "branch": "stars", "enabled": false, "params": {} },
    { "id": "star_reduce", "name": "Star Reduction", "branch": "stars", "enabled": false, "params": {} },
    { "id": "ha_sxt", "name": "Ha SXT", "branch": "ha", "enabled": false, "params": {} },
    { "id": "ha_stretch", "name": "Ha Stretch", "branch": "ha", "enabled": false, "params": {} },
    { "id": "ha_curves", "name": "Ha Curves", "branch": "ha", "enabled": false, "params": {} },
    { "id": "ha_ghs", "name": "Ha GHS", "branch": "ha", "enabled": false, "params": {} },
    { "id": "l_sxt", "name": "SynthLum SXT", "branch": "lum", "enabled": false,
      "params": { "overlap": 0.20, "recoverNebulosity": true } },
    { "id": "l_stretch", "name": "SynthLum Stretch", "branch": "lum", "enabled": false,
      "params": { "targetBg": 0.14 } },
    { "id": "l_nxt", "name": "SynthLum NXT", "branch": "lum", "enabled": false,
      "params": { "denoise": 0.45, "detail": 0.15 } },
    { "id": "l_bxt", "name": "SynthLum BXT", "branch": "lum", "enabled": false, "params": {} },
    { "id": "stretch", "name": "Stretch (HT+GHS)", "branch": "main", "enabled": true,
      "params": { "targetBg": 0.17, "ghsPasses": [
        { "label": "Midtone boost", "D": 0.8, "B": -1.0, "LP": 0.02, "HP": 0.95 },
        { "label": "Fine contrast", "D": 0.5, "B": -1.5, "LP": 0.03, "HP": 0.90 }
      ] } },
    { "id": "nxt_pass2", "name": "NXT Pass 2", "branch": "main", "enabled": true,
      "params": { "_note": "iter34: turned back UP 0.35->0.65 to clean the residual 1.5x grain (backing off drizzle means we no longer need timid denoise to protect detail)", "denoise": 0.65, "detail": 0.15 } },
    { "id": "gc_post", "name": "Post-stretch ABE (residual corner flatten)", "branch": "main", "enabled": true,
      "params": { "method": "abe", "abePolyDegree": 2, "abeTolerance": 1.0 } },
    { "id": "curves_main", "name": "Curves", "branch": "main", "enabled": true,
      "params": { "contrastCurve": [[0,0],[0.06,0.02],[0.50,0.55],[0.92,0.97],[1,1]],
                  "saturationCurve": [[0,0],[0.50,0.45],[1,0.92]] } },
    { "id": "sho_palette", "name": "SHO Palette (amber recovery)", "branch": "main", "enabled": true,
      "params": { "_note": "iter37: middle ground — amberBoost 0.50, veinBoost 0.8. Keeps SII/Ha/OIII color-mix so interior structure reads, without the intense original (0.9/1.5) or the too-flat iter36 (0.15/0.3).",
                  "greenTemper": 0.55, "amberBoost": 0.50, "blueBoost": 1.0,
                  "veinBoost": 0.8, "veinThreshold": 0.5,
                  "veinSignalFloor": 0.19, "veinSignalTransition": 0.10 } },
    { "id": "bg_neutralize", "name": "Background Neutralize", "branch": "main", "enabled": true,
      "params": { "threshold": 0.16, "transition": 0.12 } },
    { "id": "halo_suppress", "name": "Halo Suppression (Propus)", "branch": "main", "enabled": true,
      "params": { "_note": "v27: same nebula-pass fix as v26, but pullTo=0.085 makes the glow FADE to the true dark-sky floor instead of the annulus level (~0.24, which clipped the bright SNR below Propus and left a lit disc). amount 0.96, sigma 300 for a smooth fade that doesn't darken the naturally-brighter sky above Propus. Star-image pass still OFF (RGB star is perfect amber). Runs after bg_neutralize, before star_add.",
                  "_scalenote": "1.5x frame is 4180x4212 (~0.75x of the 5584x5616 2x frame). Propus center + radius/coreSigma scaled 0.75x; center re-verified against the new frame before the composite run.",
                  "halos": [ { "center": [2028, 814], "shape": "butterworth", "radius": 420, "order": 2,
                               "pullTo": 0.088,
                               "amount": 0.92, "desaturate": 0.6,
                               "starsAmount": 0.0, "starsDesaturate": 0.0, "coreSigma": 60 } ] } },
    { "id": "ha_inject", "name": "Ha Injection", "branch": "main", "merges": ["ha"], "enabled": false, "params": {} },
    { "id": "lrgb_combine", "name": "SynthLum Combine", "branch": "main", "merges": ["lum"], "enabled": false,
      "params": { "lightness": 0.50, "saturation": 0.50 } },
    { "id": "lhe", "name": "LHE (Local Contrast)", "branch": "main", "enabled": false,
      "params": { "radius": 64, "amount": 0.35, "slopeLimit": 1.5 } },
    { "id": "lhe_fine", "name": "LHE Fine", "branch": "main", "enabled": false, "params": {} },
    { "id": "hdrmt", "name": "HDR Multiscale", "branch": "main", "enabled": false, "params": {} },
    { "id": "curves_final", "name": "Final Curves", "branch": "main", "enabled": true,
      "params": { "lightnessCurve": [[0,0],[0.12,0.07],[0.50,0.52],[0.88,0.91],[1,1]],
                  "saturationCurve": [[0,0],[0.50,0.38],[1,0.72]],
                  "channelBoost": { "R": 1.0, "G": 1.0, "B": 1.0 } } },
    { "id": "chroma_denoise", "name": "Chroma Denoise (SII red color-noise)", "branch": "main", "enabled": true,
      "params": { "_note": "Luminance-protected color-noise reduction. Extracts CIE L*a*b*, smooths ONLY a*/b* then recombines with L* untouched — so structure/filaments stay sharp, only color speckle goes. Runs on the nebula BEFORE star_add (RGB star colors kept pristine). From noise characterisation: a* HF-dominated (red speckle), b* HF+LF, so b* gets a larger kernel.",
                  "sigmaA": 2.6, "sigmaB": 3.75 } },
    { "id": "star_add", "name": "Star Addition (RGB stars)", "branch": "main", "merges": ["stars"], "enabled": true,
      "params": { "starStrength": 0.9, "screenBlend": false,
                  "starsFile": "Z:/IC 443/claude-masters-cc/working/IC443_rgb_stars.xisf" } }
  ]
}
