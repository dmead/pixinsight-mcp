{
  "version": 2,
  "name": "M82 HaLRGB v4 (HDR-core masters, otherwise identical to v3)",
  "files": {
    "sourceFolder": "Z:/M82/claude-masters/working-hdr",
    "L": "Z:/M82/claude-masters/working-hdr/M82_L.xisf",
    "R": "Z:/M82/claude-masters/working-hdr/M82_R.xisf",
    "G": "Z:/M82/claude-masters/working-hdr/M82_G.xisf",
    "B": "Z:/M82/claude-masters/working-hdr/M82_B.xisf",
    "Ha": "Z:/M82/claude-masters/working-hdr/M82_Ha.xisf",
    "outputDir": "Z:/M82/claude-processed",
    "targetName": "M82"
  },
  "branches": {
    "main": { "label": "RGB", "color": "#4a9eff" },
    "stars": { "label": "Stars", "color": "#f5c542", "forkAfter": "sxt" },
    "ha": { "label": "H-alpha", "color": "#e94560", "forkAfter": "combine_rgb" },
    "lum": { "label": "Luminance", "color": "#c084fc", "forkAfter": "sxt" }
  },
  "steps": [
    { "id": "combine_rgb", "name": "Combine RGB", "branch": "main", "enabled": true, "params": {} },
    { "id": "gc", "name": "GradientCorrection (per-channel)", "branch": "main", "enabled": true,
      "params": { "perChannel": true, "method": "auto" } },
    { "id": "bxt_correct", "name": "BXT (correctOnly)", "branch": "main", "enabled": true,
      "params": { "sharpenStars": 0.50, "sharpenNonstellar": 0.75, "adjustStarHalos": 0.00 } },
    { "id": "plate_solve", "name": "Plate Solve (copy WCS from R)", "branch": "main", "enabled": true, "params": {} },
    { "id": "spcc", "name": "SPCC (Optolong LRGB, galaxy white ref)", "branch": "main", "enabled": true,
      "params": { "whiteReferenceName": "Average Spiral Galaxy", "sensorQE": "Sony IMX411/455/461/533/571",
                  "filterSet": "Optolong LRGB", "narrowbandMode": false, "generateGraphs": false } },
    { "id": "scnr", "name": "SCNR", "branch": "main", "enabled": true, "params": { "amount": 0.30 } },
    { "id": "bxt_sharpen", "name": "BXT (sharpening)", "branch": "main", "enabled": true,
      "params": { "_note": "moderate — L branch carries the structure sharpening; RGB just needs cleanup",
                  "sharpenStars": 0.20, "sharpenNonstellar": 0.50, "adjustStarHalos": 0.00 } },
    { "id": "nxt_pass1", "name": "NXT Pass 1 (linear RGB)", "branch": "main", "enabled": true,
      "params": { "denoise": 0.25, "detail": 0.15 } },
    { "id": "sxt", "name": "SXT", "branch": "main", "enabled": true,
      "params": { "_note": "galaxy field: watch for starburst-knot residuals in the star frame; knowledge doc says consider disabling entirely if leaks show",
                  "overlap": 0.20, "recoverNebulosity": true } },

    { "id": "star_stretch", "name": "Star Extraction (linear + GHS highlight-protected)", "branch": "stars", "enabled": true,
      "params": { "starMethod": "linear",
                  "_note": "same sanctioned method as IC443 stars v5, slightly gentler faint-end lift for a galaxy field",
                  "ghs": { "D": 3.5, "b": 4.0, "SP": 0.01, "LP": 0.0, "HP": 0.55, "bpSigma": 2.5 },
                  "scnrGreen": true } },
    { "id": "star_saturate", "name": "Star Saturation", "branch": "stars", "enabled": true,
      "params": { "starSaturationCurve": [[0,0],[0.10,0.55],[0.30,0.80],[0.55,0.95],[1,1]] } },
    { "id": "star_reduce", "name": "Star Reduction", "branch": "stars", "enabled": false,
      "params": { "_note": "DISABLED — ring artifacts on galaxy fields (M81/M82 lesson, no exceptions)" } },

    { "id": "ha_gc", "name": "Ha GradientCorrection", "branch": "ha", "enabled": true,
      "params": { "_note": "v3: Ha master carries the field's strong sky gradient; without this the injected red follows it — Dan flagged red background in v1", "method": "auto" } },
    { "id": "ha_continuum", "name": "Ha Continuum Subtraction", "branch": "ha", "enabled": true,
      "params": { "_note": "Dan's call: subtract scaled R from Ha, inject only the emission remainder — removes the broadband red wash at the source", "factor": 1.0 } },
    { "id": "ha_sxt", "name": "Ha SXT", "branch": "ha", "enabled": true,
      "params": { "overlap": 0.20, "recoverNebulosity": true } },
    { "id": "ha_stretch", "name": "Ha Stretch", "branch": "ha", "enabled": true,
      "params": { "targetBg": 0.10 } },
    { "id": "ha_curves", "name": "Ha Curves", "branch": "ha", "enabled": false, "params": {} },
    { "id": "ha_ghs", "name": "Ha GHS", "branch": "ha", "enabled": false, "params": {} },

    { "id": "l_sxt", "name": "L SXT", "branch": "lum", "enabled": true,
      "params": { "overlap": 0.20, "recoverNebulosity": true } },
    { "id": "l_stretch", "name": "L Stretch", "branch": "lum", "enabled": true,
      "params": { "targetBg": 0.10, "hdrHeadroom": 0.10 } },
    { "id": "l_nxt", "name": "L NXT (post-stretch)", "branch": "lum", "enabled": true,
      "params": { "denoise": 0.35, "detail": 0.15 } },
    { "id": "l_bxt", "name": "L BXT (structure)", "branch": "lum", "enabled": true,
      "params": { "sharpenStars": 0.15, "sharpenNonstellar": 0.50, "adjustStarHalos": 0.00 } },

    { "id": "stretch", "name": "Stretch (HT+GHS)", "branch": "main", "enabled": true,
      "params": { "targetBg": 0.10, "hdrHeadroom": 0.05, "ghsPasses": [
        { "label": "Midtone boost", "D": 0.6, "B": -1.0, "LP": 0.02, "HP": 0.95 },
        { "label": "Fine contrast", "D": 0.3, "B": -1.5, "LP": 0.03, "HP": 0.90 }
      ] } },
    { "id": "nxt_pass2", "name": "NXT Pass 2 (post-stretch)", "branch": "main", "enabled": true,
      "params": { "denoise": 0.35, "detail": 0.15 } },
    { "id": "curves_main", "name": "Curves (house style, muted)", "branch": "main", "enabled": true,
      "params": { "contrastCurve": [[0,0],[0.06,0.02],[0.50,0.55],[0.92,0.97],[1,1]],
                  "saturationCurve": [[0,0],[0.50,0.55],[1,0.92]] } },
    { "id": "ha_inject", "name": "Ha Injection (superwind)", "branch": "main", "merges": ["ha"], "enabled": true,
      "params": { "_note": "v3: red wash fixed at the ROOT by ha_continuum (Dan's call), so injection returns to full strength on pure emission. lumBoost stays moderate — emission-only lum lift.",
                  "injectionStrength": 0.65, "haThreshold": 0.3, "detailLayer": 0.55, "lumBoost": 0.25,
                  "maskClipLow": 0.04, "maskBlur": 8 } },
    { "id": "lrgb_combine", "name": "LRGB Combine", "branch": "main", "merges": ["lum"], "enabled": true,
      "params": { "_note": "large bright galaxy: lightness 0.50 per galaxy table; LinearFit L->RGB lum guard",
                  "lightness": 0.50, "saturation": 0.70, "linearFitRejectHigh": 0.92 } },
    { "id": "lhe", "name": "LHE (structural)", "branch": "main", "enabled": true,
      "params": { "radius": 64, "amount": 0.35, "slopeLimit": 1.5, "maskGamma": 2.0 } },
    { "id": "lhe_fine", "name": "LHE Fine", "branch": "main", "enabled": false, "params": {} },
    { "id": "hdrmt", "name": "HDR Multiscale (core detail)", "branch": "main", "enabled": true,
      "params": { "numberOfLayers": 7, "numberOfIterations": 3, "toLightness": true,
                  "maskClipLow": 0.10, "maskGamma": 1.5 } },
    { "id": "nxt_final", "name": "NXT Final (light cleanup)", "branch": "main", "enabled": true,
      "params": { "denoise": 0.30, "detail": 0.15 } },
    { "id": "bg_neutralize", "name": "Background Neutralize", "branch": "main", "enabled": true,
      "params": { "_note": "v3: missing in v1 — final median ~0.05, so threshold 0.09 catches sky without touching either galaxy",
                  "threshold": 0.09, "transition": 0.10 } },
    { "id": "curves_final", "name": "Final Curves (house style)", "branch": "main", "enabled": true,
      "params": { "lightnessCurve": [[0,0],[0.05,0.01],[0.10,0.04],[0.50,0.52],[0.90,0.93],[1,1]],
                  "saturationCurve": [[0,0],[0.50,0.60],[1,0.90]],
                  "channelBoost": { "R": 1.0, "G": 1.0, "B": 1.0 } } },
    { "id": "star_add", "name": "Star Addition (screen blend)", "branch": "main", "merges": ["stars"], "enabled": true,
      "params": { "_note": "screen blend essential for galaxies — straight add shows SXT residual rims",
                  "starStrength": 0.85, "screenBlend": true } }
  ]
}
