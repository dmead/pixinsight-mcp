{
  "version": 2,
  "name": "Sh2-101 (Tulip) SHO — v2 (de-green + warm rebalance: Ha-green to gold, OIII to teal)",
  "files": {
    "sourceFolder": "Z:/Sh2 101/claude/working",
    "L": "",
    "R": "Z:/Sh2 101/claude/working/Sh2101_SII.xisf",
    "G": "Z:/Sh2 101/claude/working/Sh2101_Ha.xisf",
    "B": "Z:/Sh2 101/claude/working/Sh2101_OIII.xisf",
    "Ha": "",
    "outputDir": "Z:/Sh2 101/claude/processed",
    "targetName": "Sh2101"
  },
  "branches": {
    "main": { "label": "SHO", "color": "#4a9eff" },
    "stars": { "label": "Stars", "color": "#f5c542", "forkAfter": "sxt" },
    "ha": { "label": "H-alpha", "color": "#e94560", "forkAfter": "combine_rgb" },
    "lum": { "label": "SynthLum", "color": "#c084fc", "forkAfter": "sxt" }
  },
  "steps": [
    { "id": "combine_rgb", "name": "Combine SHO", "branch": "main", "enabled": true, "params": {} },
    { "id": "gc", "name": "GradientCorrection", "branch": "main", "enabled": true,
      "params": { "perChannel": true, "method": "auto" } },
    { "id": "bxt_correct", "name": "BXT (correctOnly)", "branch": "main", "enabled": true,
      "params": { "sharpenStars": 0.50, "sharpenNonstellar": 0.90, "adjustStarHalos": 0.00 } },
    { "id": "plate_solve", "name": "Plate Solve", "branch": "main", "enabled": false, "params": {} },
    { "id": "spcc", "name": "SPCC", "branch": "main", "enabled": false,
      "params": { "_note": "disabled — false-color SHO palette" } },
    { "id": "scnr", "name": "SCNR", "branch": "main", "enabled": false,
      "params": { "_note": "disabled — green IS Ha in SHO" } },
    { "id": "bxt_sharpen", "name": "BXT (sharpening)", "branch": "main", "enabled": true,
      "params": { "sharpenStars": 0.25, "sharpenNonstellar": 0.90, "adjustStarHalos": 0.00 } },
    { "id": "nxt_pass1", "name": "NXT Pass 1", "branch": "main", "enabled": true,
      "params": { "denoise": 0.20, "detail": 0.20 } },
    { "id": "sxt", "name": "SXT", "branch": "main", "enabled": true,
      "params": { "overlap": 0.20, "recoverNebulosity": true } },
    { "id": "star_stretch", "name": "Star Extraction (linear + GHS)", "branch": "stars", "enabled": true,
      "params": { "_note": "internal SHO stars (no broadband RGB for this target). Linear extraction + GHS highlight protection; scnrGreen cleans any green star cores.",
                  "starMethod": "linear",
                  "ghs": { "D": 3.5, "b": 3.0, "SP": 0.01, "LP": 0.0, "HP": 0.6, "bpSigma": 2.5 },
                  "scnrGreen": true } },
    { "id": "star_saturate", "name": "Star Saturation", "branch": "stars", "enabled": true,
      "params": { "_note": "moderate desaturation — SHO stars are near-continuum (white-ish); keep them clean/neutral, not magenta",
                  "starSaturationCurve": [[0,0],[0.50,0.35],[1,0.80]] } },
    { "id": "star_reduce", "name": "Star Reduction", "branch": "stars", "enabled": false, "params": {} },
    { "id": "ha_sxt", "name": "Ha SXT", "branch": "ha", "enabled": false, "params": {} },
    { "id": "ha_stretch", "name": "Ha Stretch", "branch": "ha", "enabled": false, "params": {} },
    { "id": "ha_curves", "name": "Ha Curves", "branch": "ha", "enabled": false, "params": {} },
    { "id": "ha_ghs", "name": "Ha GHS", "branch": "ha", "enabled": false, "params": {} },
    { "id": "l_sxt", "name": "SynthLum SXT", "branch": "lum", "enabled": false, "params": {} },
    { "id": "l_stretch", "name": "SynthLum Stretch", "branch": "lum", "enabled": false, "params": {} },
    { "id": "l_nxt", "name": "SynthLum NXT", "branch": "lum", "enabled": false, "params": {} },
    { "id": "l_bxt", "name": "SynthLum BXT", "branch": "lum", "enabled": false, "params": {} },
    { "id": "stretch", "name": "Stretch (HT+GHS)", "branch": "main", "enabled": true,
      "params": { "targetBg": 0.16, "ghsPasses": [
        { "label": "Midtone boost", "D": 0.8, "B": -1.0, "LP": 0.02, "HP": 0.95 },
        { "label": "Fine contrast", "D": 0.5, "B": -1.5, "LP": 0.03, "HP": 0.90 }
      ] } },
    { "id": "nxt_pass2", "name": "NXT Pass 2", "branch": "main", "enabled": true,
      "params": { "denoise": 0.60, "detail": 0.15 } },
    { "id": "gc_post", "name": "Post-stretch ABE (residual corner flatten)", "branch": "main", "enabled": true,
      "params": { "method": "abe", "abePolyDegree": 2, "abeTolerance": 1.0 } },
    { "id": "curves_main", "name": "Curves", "branch": "main", "enabled": true,
      "params": { "contrastCurve": [[0,0],[0.06,0.02],[0.50,0.55],[0.92,0.97],[1,1]],
                  "saturationCurve": [[0,0],[0.50,0.45],[1,0.92]] } },
    { "id": "sho_palette", "name": "SHO Palette (amber recovery)", "branch": "main", "enabled": true,
      "params": { "_note": "v2: Ha-dominant target reads all-green in v1. Strong greenTemper 0.85 knocks the Ha-green excess down; amberBoost 0.8 lifts SII-red where present; blueBoost 1.15 brings out OIII teal. Warmth added downstream via curves_final channelBoost (de-green alone = gray on Ha-dominant data).",
                  "greenTemper": 0.85, "amberBoost": 0.80, "blueBoost": 1.15,
                  "veinBoost": 0.8, "veinThreshold": 0.5,
                  "veinSignalFloor": 0.19, "veinSignalTransition": 0.10 } },
    { "id": "bg_neutralize", "name": "Background Neutralize", "branch": "main", "enabled": true,
      "params": { "threshold": 0.16, "transition": 0.12 } },
    { "id": "halo_suppress", "name": "Halo Suppression", "branch": "main", "enabled": false,
      "params": { "_note": "disabled — no dominant bright star to tame for this target" } },
    { "id": "ha_inject", "name": "Ha Injection", "branch": "main", "merges": ["ha"], "enabled": false, "params": {} },
    { "id": "lrgb_combine", "name": "SynthLum Combine", "branch": "main", "merges": ["lum"], "enabled": false, "params": {} },
    { "id": "lhe", "name": "LHE (Local Contrast)", "branch": "main", "enabled": false, "params": {} },
    { "id": "lhe_fine", "name": "LHE Fine", "branch": "main", "enabled": false, "params": {} },
    { "id": "hdrmt", "name": "HDR Multiscale", "branch": "main", "enabled": false, "params": {} },
    { "id": "curves_final", "name": "Final Curves", "branch": "main", "enabled": true,
      "params": { "lightnessCurve": [[0,0],[0.12,0.07],[0.50,0.52],[0.88,0.91],[1,1]],
                  "saturationCurve": [[0,0],[0.50,0.42],[1,0.78]],
                  "channelBoost": { "R": 1.35, "G": 0.90, "B": 1.12 } } },
    { "id": "chroma_denoise", "name": "Chroma Denoise", "branch": "main", "enabled": true,
      "params": { "sigmaA": 2.6, "sigmaB": 3.75 } },
    { "id": "star_add", "name": "Star Addition (internal SHO stars)", "branch": "main", "merges": ["stars"], "enabled": true,
      "params": { "_note": "internal stars — no starsFile; adds the separately-stretched SHO stars back",
                  "starStrength": 0.9, "screenBlend": false } }
  ]
}
