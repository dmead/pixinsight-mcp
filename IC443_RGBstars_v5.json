{
  "version": 2,
  "name": "IC443 RGB Stars v5 (more faint-star lift — b 3->6 for denser visible field, HP still 0.55)",
  "files": {
    "sourceFolder": "Z:/IC 443/claude-masters/working",
    "L": "",
    "R": "Z:/IC 443/claude-masters/working/IC443_R_broadband.xisf",
    "G": "Z:/IC 443/claude-masters/working/IC443_G_broadband.xisf",
    "B": "Z:/IC 443/claude-masters/working/IC443_B_broadband.xisf",
    "Ha": "",
    "outputDir": "Z:/IC 443/claude-processed/auxiliary",
    "targetName": "IC443stars"
  },
  "branches": {
    "main": { "label": "RGB", "color": "#4a9eff" },
    "stars": { "label": "Stars", "color": "#f5c542", "forkAfter": "sxt" },
    "ha": { "label": "H-alpha", "color": "#e94560", "forkAfter": "combine_rgb" },
    "lum": { "label": "Luminance", "color": "#c084fc", "forkAfter": "sxt" }
  },
  "steps": [
    { "id": "combine_rgb", "name": "Combine RGB", "branch": "main", "enabled": true, "params": {} },
    { "id": "gc", "name": "GradientCorrection", "branch": "main", "enabled": true, "params": {} },
    { "id": "bxt_correct", "name": "BXT (correctOnly)", "branch": "main", "enabled": true,
      "params": { "sharpenStars": 0.50, "sharpenNonstellar": 0.75, "adjustStarHalos": 0.00 } },
    { "id": "plate_solve", "name": "Plate Solve (copy WCS from R)", "branch": "main", "enabled": true, "params": {} },
    { "id": "spcc", "name": "SPCC (Optolong LRGB)", "branch": "main", "enabled": true,
      "params": { "whiteReferenceName": "Average Spiral Galaxy", "sensorQE": "Sony IMX411/455/461/533/571",
                  "filterSet": "Optolong LRGB", "narrowbandMode": false, "generateGraphs": false } },
    { "id": "scnr", "name": "SCNR", "branch": "main", "enabled": false,
      "params": { "_note": "disabled — SPCC-calibrated color must not be recast" } },
    { "id": "bxt_sharpen", "name": "BXT (sharpening)", "branch": "main", "enabled": false, "params": {} },
    { "id": "nxt_pass1", "name": "NXT Pass 1", "branch": "main", "enabled": false, "params": {} },
    { "id": "sxt", "name": "SXT", "branch": "main", "enabled": true,
      "params": { "overlap": 0.20, "recoverNebulosity": true } },
    { "id": "star_stretch", "name": "Star Extraction (linear + GHS highlight-protected)", "branch": "stars", "enabled": true,
      "params": { "starMethod": "linear",
                  "_note": "v5: MORE faint stars. b 3->6 concentrates the hyperbolic lift harder at the faint end (SP 0.01->0.008, near faint-star level); D 3.5->4.0 slightly stronger overall. HP stays 0.55 so bright stars & Propus remain protected/amber. bpSigma 2.5 clips sky floor first. scnrGreen removes the green core the aggressive b=6 lift gives bright saturated stars (Propus) — SCNR AverageNeutral, stars are never green so real stars untouched. This makes iteration 28 fully reproducible from a rebuild (no manual SCNR needed).",
                  "ghs": { "D": 4.0, "b": 6.0, "SP": 0.008, "LP": 0.0, "HP": 0.55, "bpSigma": 2.5 },
                  "scnrGreen": true,
                  "saveStarsTo": "Z:/IC 443/claude-masters/working/IC443_rgb_stars.xisf" } },
    { "id": "star_saturate", "name": "Star Saturation", "branch": "stars", "enabled": true,
      "params": { "starSaturationCurve": [[0,0],[0.10,0.55],[0.30,0.80],[0.55,0.95],[1,1]] } },
    { "id": "star_reduce", "name": "Star Reduction", "branch": "stars", "enabled": false, "params": {} },
    { "id": "ha_sxt", "name": "Ha SXT", "branch": "ha", "enabled": false, "params": {} },
    { "id": "ha_stretch", "name": "Ha Stretch", "branch": "ha", "enabled": false, "params": {} },
    { "id": "ha_curves", "name": "Ha Curves", "branch": "ha", "enabled": false, "params": {} },
    { "id": "ha_ghs", "name": "Ha GHS", "branch": "ha", "enabled": false, "params": {} },
    { "id": "l_stretch", "name": "L Stretch", "branch": "lum", "enabled": false, "params": {} },
    { "id": "l_nxt", "name": "L NXT", "branch": "lum", "enabled": false, "params": {} },
    { "id": "l_bxt", "name": "L BXT", "branch": "lum", "enabled": false, "params": {} },
    { "id": "stretch", "name": "Stretch (HT)", "branch": "main", "enabled": false,
      "params": { "_note": "disabled — stars already saved after star_saturate; main starless output unused", "targetBg": 0.25, "ghsPasses": [] } },
    { "id": "nxt_pass2", "name": "NXT Pass 2", "branch": "main", "enabled": false, "params": {} },
    { "id": "curves_main", "name": "Curves", "branch": "main", "enabled": false, "params": {} },
    { "id": "ha_inject", "name": "Ha Injection", "branch": "main", "merges": ["ha"], "enabled": false, "params": {} },
    { "id": "lrgb_combine", "name": "LRGB Combine", "branch": "main", "merges": ["lum"], "enabled": false, "params": {} },
    { "id": "lhe", "name": "LHE", "branch": "main", "enabled": false, "params": {} },
    { "id": "hdrmt", "name": "HDR Multiscale", "branch": "main", "enabled": false, "params": {} },
    { "id": "curves_final", "name": "Final Curves", "branch": "main", "enabled": false, "params": {} },
    { "id": "star_add", "name": "Star Addition", "branch": "main", "merges": ["stars"], "enabled": false, "params": {} }
  ]
}
